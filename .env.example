# Copy to .env with scripts/init.sh, then edit DATA_DIR before the first start.
# .env holds the S3 credentials. Keep it on the server and out of git.

# Dedicated disk mount in production, for example /var/lib/librefs/object-storage.
# A relative path is stored next to this compose file.
DATA_DIR=./data

# Localhost only. Other containers should join the librefs-storage network
# and use http://filer:8333. Set S3_BIND=0.0.0.0 only behind a firewall or TLS proxy.
S3_BIND=127.0.0.1
S3_PORT=8333

# Browser UI. Uses the same bind as S3 when ADMIN_BIND is unset.
# Login is WEED_ADMIN_USER / WEED_ADMIN_PASSWORD. Required when the UI is reachable
# beyond this host, which it is whenever the bind address is not 127.0.0.1.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=23646
WEED_ADMIN_USER=admin
WEED_ADMIN_PASSWORD=replace-me

# Alphanumeric, 16-128 characters. scripts/init.sh fills these in.
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# Volume size in MB. The image entrypoint also sets 1024; this value is applied after it.
# 10240 is a practical size: compaction stays short, and a large disk does not create
# tens of thousands of volumes.
VOLUME_SIZE_LIMIT_MB=10240

# Memory ceilings. Raise VOLUME_MEMORY_LIMIT when the data disk is large.
MASTER_MEMORY_LIMIT=1g
VOLUME_MEMORY_LIMIT=4g
FILER_MEMORY_LIMIT=2g
